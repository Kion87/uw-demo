generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  publicId  String?  @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depositAddresses DepositAddress[]
  sessions         Session[]
  deposits Deposit[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model DepositAddress {
  id        String   @id @default(cuid())
  userId    Int
  assetKey  String
  invoiceId String?
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetKey])
  @@index([userId])
}

model Deposit {
  id              Int      @id @default(autoincrement())

  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What user selected (mapped to Uniwire)
  asset           String   // e.g. "USDT", "BTC"
  network         String   // e.g. "ETH", "BTC", "TRX", "SOL" (Uniwire "kind")

  // Optional: because Uniwire invoices can be created without amount for reusable addresses
  amount          Decimal? @db.Decimal(36, 18)

  // Link to Uniwire invoice/address created for this deposit request
  uniwireInvoiceId String  @unique
  address          String

  status          String   @default("new") // matches Uniwire statuses like "new", "pending", "complete", "expired" :contentReference[oaicite:1]{index=1}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}