generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  publicId  String?  @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depositAddresses DepositAddress[]
  sessions         Session[]
  deposits Deposit[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model DepositAddress {
  id        String   @id @default(cuid())
  userId    Int
  assetKey  String
  invoiceId String?
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetKey])
  @@index([userId])
}

model Deposit {
  id                   Int       @id @default(autoincrement())

  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What user selected (mapped to Uniwire)
  asset                String    // e.g. "USDT", "BTC"
  network              String    // e.g. "ETH", "BTC", "TRX", "SOL" (Uniwire "kind")

  // Optional: invoices can be created without amount for reusable addresses
  amount               Decimal?  @db.Decimal(36, 18)

  // Fiat-equivalent value at time of deposit (from Uniwire's amount.paid.quotes.USD)
  fiatAmount           Decimal?  @db.Decimal(20, 6)
  fiatCurrency         String?

  // Invoice/address used (NOT unique because address can receive multiple tx)
  uniwireInvoiceId     String
  address              String

  // Transaction-based idempotency (unique per actual deposit tx)
  uniwireTransactionId String?    @unique
  txid                 String?

  status               String    @default("new")

  executedAt           DateTime?
  confirmedAt          DateTime?
  confirmations        Int?
  creditedAt           DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([uniwireInvoiceId])
}

model UniwireCallback {
  id         Int      @id @default(autoincrement())
  callbackId String   @unique
  receivedAt DateTime @default(now())
}