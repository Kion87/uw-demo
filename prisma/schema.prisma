generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  publicId  String?  @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixedAmountInvoices Boolean @default(false)

  depositAddresses DepositAddress[]
  sessions         Session[]
  deposits Deposit[]
  withdrawals Withdrawal[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model DepositAddress {
  id        String   @id @default(cuid())
  userId    Int
  assetKey  String
  invoiceId String?
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetKey])
  @@index([userId])
}

model Deposit {
  id                   Int       @id @default(autoincrement())

  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What user selected (mapped to Uniwire)
  asset                String    // e.g. "USDT", "BTC"
  network              String    // e.g. "ETH", "BTC", "TRX", "SOL" (Uniwire "kind")

  // Optional: invoices can be created without amount for reusable addresses.
  // For fixed-amount invoices, this holds the amount actually paid so far
  // (updated by invoice_* callbacks) - NOT the requested amount.
  amount               Decimal?  @db.Decimal(36, 18)

  // Fixed-amount invoice ask, set once at creation. Null for reusable-address
  // deposits (which have no "requested" concept).
  requestedAmount      Decimal?  @db.Decimal(36, 18)

  // Fiat-equivalent value at time of deposit (from Uniwire's amount.paid.quotes.USD)
  fiatAmount           Decimal?  @db.Decimal(20, 6)
  fiatCurrency         String?

  // Invoice/address used (NOT unique because address can receive multiple tx)
  uniwireInvoiceId     String
  address              String

  // Transaction-based idempotency (unique per actual deposit tx)
  uniwireTransactionId String?    @unique
  txid                 String?

  status               String    @default("new")

  executedAt           DateTime?
  confirmedAt          DateTime?
  confirmations        Int?
  creditedAt           DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([uniwireInvoiceId])
}

model Withdrawal {
  id                   Int       @id @default(autoincrement())

  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What user selected (mapped to Uniwire)
  asset                String    // currency sent to Uniwire, e.g. "BTC", "ETH", "USDT"
  network              String    // "kind" sent to Uniwire, e.g. "BTC", "ETH_USDT"

  amount               Decimal   @db.Decimal(36, 18)

  // Fiat-equivalent value, if a payout response ever includes a USD quote
  fiatAmount           Decimal?  @db.Decimal(20, 6)
  fiatCurrency         String?

  destinationAddress   String

  // Our own idempotency key, generated before contacting Uniwire and sent as
  // "reference_id" on every attempt/retry, so retries after an ambiguous
  // failure can't create a duplicate payout on Uniwire's side.
  referenceId          String    @unique

  // payout.id from Uniwire's create-payout response; may be null if our
  // request was ambiguous (timeout/network error) and we never learned it -
  // in that case it gets backfilled once a callback arrives.
  uniwirePayoutId      String?   @unique
  txid                 String?

  status               String    @default("reserved") // reserved | pending | initialized | confirmed | complete | rejected | failed
  errorMessage         String?

  executedAt           DateTime?
  confirmedAt          DateTime?
  confirmations        Int?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, createdAt])
}

model UniwireCallback {
  id         Int      @id @default(autoincrement())
  callbackId String   @unique
  receivedAt DateTime @default(now())
}